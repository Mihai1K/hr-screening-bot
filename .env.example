# Токен от @BotFather
BOT_TOKEN=

# Чат, куда падают карточки кандидатов.
# Можно не заполнять: отправь в нужном чате /hr@имя_бота — бот запомнит сам.
HR_CHAT_ID=

# База. Порт 5433 — как в docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hr_bot

# Часовой пояс, в котором назначаются созвоны
TIMEZONE=Europe/Moscow

# Окна для созвонов: день_недели:начало-конец
# 1 = понедельник … 7 = воскресенье
CALL_WINDOWS=1:11:00-12:00,2:12:00-13:00,3:13:00-14:00,4:14:00-15:00,5:15:00-16:00

# Длина одного слота в минутах
SLOT_MINUTES=10

# На сколько рабочих дней вперёд открывать запись
CALL_DAYS_AHEAD=10

# За сколько минут до слота его ещё можно выбрать на сегодня
MIN_LEAD_MINUTES=90

# Название компании — подставляется в текст вакансии
COMPANY_NAME=Медиацентр

# Ссылка на политику обработки персональных данных (можно оставить пустой)
PRIVACY_URL=

# Выгрузка в Google Таблицу. Инструкция — в google-sheets/Code.gs и README.
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Необязательные вопросы анкеты: 0 — не спрашивать
ASK_RESUME=1
ASK_ABOUT=1

# Картинка над приветствием (путь от корня проекта). Пусто — без фото.
WELCOME_IMAGE=assets/logo.png

# Суточный сигнал «бот жив»: время HH:MM, пусто — выключено
HEARTBEAT_TIME=09:00
# Куда слать сигнал. Пусто — в тот же чат, что и карточки
HEARTBEAT_CHAT=
